.btn-xs {
	padding: 3px 10px;
	font-size: 12px;
	line-height: 1.4;
	border-radius: 4px;
}

.showModal,
.showAssetForNewWorks,
.showFundingAgencyDetails,						  
.showModalNewAsset,
.showModalMaintenance,
.ItemsModal {
    display: none;
    position: fixed;
    z-index: 100000;
    padding-top: 100px;
    left: 0;
    top: 0;
    width: 100%;
    height: 100%;
    overflow: auto;
    background-color: rgb(0, 0, 0);
    background-color: rgba(0, 0, 0, 0.4);
}

/* Modal Content */
.showModalContent,
.showModalNewAssetContent,
.showModalContentMaintenanace,
.ItemsModalContent {
    background-color: #fefefe;
    margin: auto;
    padding: 20px;
    border: 1px solid #888;
    width: 60%;
}

/* The Close Button */
.closeShowModal,
.closeShowModalNewAsset,
.closeShowModalMaintenance,
.closeItemsModal {
    color: #aaaaaa;
    float: right;
    font-size: 28px;
    font-weight: bold;
}

.closeShowModal:hover,
.closeShowModal:focus,
.closeShowModalNewAsset:hover,
.closeShowModalNewAsset:focus,
.closeShowModalMaintenance:hover,
.closeShowModalMaintenance:focus,
.closeItemsModal:hover,
.closeItemsModal:focus {
    color: #000;
    text-decoration: none;
    cursor: pointer;
}

