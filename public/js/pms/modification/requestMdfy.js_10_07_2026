function addWorkItem() {

    const itemSelect = document.getElementById("item_cd");
    const qtyInput = document.getElementById("quantity");
    const startDateInput = document.getElementById("start_date");
    const endDateInput = document.getElementById("end_date");
	const startDateError = document.getElementById("start_date_error").innerText.trim();
    const endDateError = document.getElementById("end_date_error").innerText.trim();

    const item_cd = itemSelect.value;
    const item_name = itemSelect.options[itemSelect.selectedIndex]?.text || "";
    const quantity = qtyInput.value;
    const startDate = startDateInput.value;
    const endDate = endDateInput.value;

    if (!item_cd) {
        alert("Select Item of Work");
        return;
    }

    if (!quantity || Number(quantity) <= 0) {
        alert("Enter Quantity");
        return;
    }

    if (!startDate || Date(startDate) <= 0) {
        alert("Enter Start Date");
        return;
    }

    if (!endDate || Date(endDate) <= 0) {
        alert("Enter End Date");
        return;
    }

	if (startDateError || endDateError) {
        return;
    }
    work_rowIndex++;

    const tbody = document.querySelector("#workItemTable tbody");

    const tr = document.createElement("tr");

    tr.innerHTML = `
        <td>
            <input type="hidden"
                name="item_cd_${work_rowIndex}"
                value="${item_cd}">
            ${item_name}
        </td>

        <td>
            <input type="hidden"
                name="quantity_${work_rowIndex}"
                value="${quantity}">
            ${quantity}
        </td>

        <td>
            <input type="hidden"
                name="est_start_date_${work_rowIndex}"
                value="${startDate}">
            ${startDate}
        </td>

        <td>
            <input type="hidden"
                name="est_end_date_${work_rowIndex}"
                value="${endDate}">
            ${endDate}
        </td>

        <td>
            <button type="button"
                class="btn btn-danger btn-sm deleteWorkBtn">
                Delete
            </button>
        </td>
    `;

    tbody.appendChild(tr);

    tr.querySelector(".deleteWorkBtn")
        .addEventListener("click", () => {
            tr.remove();
        });

    document.getElementById("work_rowCount").value = work_rowIndex;

    itemSelect.value = "";
    qtyInput.value = "";
    startDateInput.value = "";
    endDateInput.value = "";
}

