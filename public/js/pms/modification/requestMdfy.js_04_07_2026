    const changedWorkItems = changesData?.work_item || [];
    const tbody = document.querySelector("#workItemTable tbody");

    if (!tbody) return;

    tbody.innerHTML = "";
    work_rowIndex = 0;

    workItems.forEach(item => {
        work_rowIndex++;

        const editable = changedWorkItems.includes(Number(item.id));

        const tr = document.createElement("tr");

        tr.innerHTML = `
            <td>
                ${
                    editable
                    ? `
                        <select name="item_cd_${work_rowIndex}"
                            class="form-select form-select-sm">
                            ${itemOfWorks.map(opt => `
                                <option value="${opt.item_cd}"
                                    ${Number(opt.item_cd) === Number(item.item_cd) ? "selected" : ""}>
                                    ${opt.item_name}
