            `;
        });

        schemeHtml += `</div>`;
    }

    schemeHtml += `</div>`;

    html += schemeHtml;
    //end			 
    html += `
        <div class="alert alert-warning shadow-sm mb-3">
            <div class="fw-bold mb-1">Reason for Modification</div>
