$(document).on('click', '.requestEditBtn', function () {

    // reset
    $('#requestModificationForm')[0].reset();
    $('#projectDetailsContainer').empty();
    $('#project_cd').val('');

    let project = $(this).data('project');
    let id = project.project_cd;
    let others = project.others ? JSON.parse(project.others) : {};

    $('#project_cd').val(id);

    let labels = {
        project_name: 'Project Name',
        project_end_date: 'Project End Date',
                //by dipshikha
        project_awarded_to: 'Project Awarded To',
        //end
        est_proj_cost: 'Estimated Cost',
        defect_liability_period: 'Defect Liability Period',
        work_order_amount: 'Work Order Amount',
        //by dipshikha
        work_order_no: 'Work Order Number',
        work_order_issue_date: 'Work Order Issue Date'
        //end
    };

	//by dipshikha
    let schemeHtml = `
        <div>
            <b>Scheme:</b> ${project.scheme_name || 'N/A'}
        </div>
    `;

    if (project.funding_agencies?.length) {

        schemeHtml += `
            <div class="mt-2">
                <b>Funding Agencies:</b><br>
        `;

        project.funding_agencies.forEach((agency, index) => {

            schemeHtml += `
                <div class="ms-3 mb-2">

                    ${index + 1}. ${agency.agency_name}<br>

                    <small>
                        Percentage:
                        ${agency.funding_percentage}%<br>

                        Amount:
                        ${agency.funding_amount}
                    </small>

                </div>
            `;
        });

        schemeHtml += `</div>`;
    }
    //end
    let values = {
        project_name: project.project_name || 'N/A',
		 //by dipshikha
        project_end_date: formatDate(project.project_end_date) || 'N/A',
        project_awarded_to: project.contractor_name || 'N/A',
        //end
        est_proj_cost: project.est_proj_cost || 'N/A',
        defect_liability_period: project.defect_liability_period || 'N/A',
        work_order_amount: project.work_order_amount || 'N/A',
        //by dipshikha
        work_order_no: project.work_order_no || 'N/A',
        work_order_issue_date: formatDate(project.work_order_issue_date) || 'N/A',
        scheme_name: schemeHtml || 'N/A'
        //end
    };

    //by dipshikha
    Object.assign(labels, {
        scheme_name: 'Scheme'
    });
    //end
    if (project.project_type_cd === 'NEW') {

        Object.assign(labels, {
            new_road_name: 'Road Name',
            new_road_length: 'Road Length',
            number_of_bridge: 'No. of Bridge',
            number_of_culvert: 'No. of Culvert',
            number_of_retain_wall: 'No. of Retaining Wall'
        });

        Object.assign(values, {
            new_road_name: others.new_road_name || 'N/A',
            new_road_length: others.new_road_length || 'N/A',
            number_of_bridge: others.number_of_bridge || 0,
            number_of_culvert: others.number_of_culvert || 0,
            number_of_retain_wall: others.number_of_retain_wall || 0
        });

        renderTable(labels, values, id);
    }else if (project.project_type_cd === 'MTN') {

        $.ajax({
            type: "GET",
            url: "/project-management/get-maintenance-detail/" + encodeURIComponent(id),
            headers: {
                "X-CSRF-TOKEN": $('meta[name="csrf-token"]').attr("content"),
            },
            data: {
                table: 'approved'
            },
            success: function (response) {

                let maintenanceAsset = 'NA';

                if (response.status === 'success') {

                    let data = response.data;

                    let parts = [];

                    if (data.road_names?.length) {
                        parts.push(`<b>Roads:</b> ${data.road_names.join(', ')}`);
                    }

                    if (data.culverts?.length) {
                        parts.push(`<b>Culverts:</b> ${data.culverts.join(', ')}`);
                    }

                    if (data.bridges?.length) {
                        parts.push(`<b>Bridges:</b> ${data.bridges.join(', ')}`);
                    }

                    if (data.walls?.length) {
                        parts.push(`<b>Walls:</b> ${data.walls.join(', ')}`);
                    }

                    maintenanceAsset = parts.length
                        ? parts.join('<br>')
                        : 'NA';
                }

                Object.assign(labels, {
                    redefine_existing_asset: 'Redefine Of Existing Asset'
                });

                Object.assign(values, {
                    redefine_existing_asset: maintenanceAsset
                });

                renderTable(labels, values, id);
            },
            error: function () {

                Object.assign(labels, {
                    redefine_existing_asset: 'Redefine Of Existing Asset'
                });

                Object.assign(values, {
                    redefine_existing_asset: 'NA'
                });

                renderTable(labels, values, id);
            }
        });
    }else if (project.project_type_cd === 'UPG') {
        $('#projectDetailsContainer').html(`
            <div class="text-center py-4 text-primary">
                Loading project details...
            </div>
        `);

        $.ajax({
            type: "GET",
            url: "/project-management/get-upgradation-detail/" + encodeURIComponent(id),
            headers: {
                "X-CSRF-TOKEN": $('meta[name="csrf-token"]').attr("content"),
            },
            data: {
                table: 'approved'
            },
            success: function (response) {

                let existingAsset = 'NA';
                let newAsset = 'NA';

                if (response.status === "success") {

                    let data = response.data;

                    // -----------------------------
                    // Existing Assets Summary
                    // -----------------------------
                    if (data.roads && data.roads.length) {

                        existingAsset = data.roads.map((r, index) => {

                            let culverts = (r.culverts && r.culverts.length)
                                ? `<b>Culverts:</b> ${r.culverts.join(', ')}<br>`
                                : '';

                            let bridges = (r.bridges && r.bridges.length)
                                ? `<b>Bridges:</b> ${r.bridges.join(', ')}<br>`
                                : '';

                            let walls = (r.walls && r.walls.length)
                                ? `<b>Walls:</b> ${r.walls.join(', ')}<br>`
                                : '';

                            let newAdded = [];

                            if (r.new_bridges_existing > 0) {
                                newAdded.push(`Bridges: ${r.new_bridges_existing}`);
                            }

                            if (r.new_culverts_existing > 0) {
                                newAdded.push(`Culverts: ${r.new_culverts_existing}`);
                            }

                            if (r.new_walls_existing > 0) {
                                newAdded.push(`Walls: ${r.new_walls_existing}`);
                            }

                            let newAddedHtml = newAdded.length
                                ? `<b>Newly Added →</b> ${newAdded.join(', ')}`
                                : '';

                            return `
                                <div class="mb-2">
                                    <b>Road ${index + 1}:</b> ${r.road_name || 'NA'}<br>

                                    ${culverts}
                                    ${bridges}
                                    ${walls}

                                    ${newAddedHtml}
                                </div>
                            `;
                        }).join('');
                    }

                    // -----------------------------
                    // New Asset Summary
                    // -----------------------------
                    newAsset = `
                        <div>
                            <b>Road Name:</b> ${data.new_road_name || 'NA'} <br>
                            <b>Road Length:</b> ${data.new_road_length || 0} <br>
                            <b>Bridges:</b> ${data.new_bridges || 0} <br>
                            <b>Culverts:</b> ${data.new_culverts || 0} <br>
                            <b>Walls:</b> ${data.new_walls || 0}
                        </div>
                    `;

                    Object.assign(labels, {
                        redefine_existing_asset: 'Redefine Of Existing Asset',
                        creation_of_new_asset: 'Creation Of New Asset'
                    });

                    Object.assign(values, {
                        redefine_existing_asset: existingAsset,
                        creation_of_new_asset: newAsset
                    });
                }

                renderTable(labels, values, id);
            },
            error: function () {

                Object.assign(labels, {
                    redefine_existing_asset: 'Redefine Of Existing Asset',
                    creation_of_new_asset: 'Creation Of New Asset'
                });

                Object.assign(values, {
                    redefine_existing_asset: 'NA',
                    creation_of_new_asset: 'NA'
                });

                renderTable(labels, values, id);
            }
        });
    }
});


// ======================================================
// Render Table + Load Work Items
// ======================================================
function renderTable(labels, values, id) {

    let html = `
        <table class="table table-bordered table-sm text-xs">
            <thead class="bg-light">
                <tr>
                    <th width="10%">Select</th>
                    <th width="35%">Field</th>
                    <th width="55%">Current Value</th>
                </tr>
            </thead>
            <tbody>
    `;

    Object.keys(labels).forEach(key => {

        html += `
            <tr>
                <td class="text-center align-middle">
                    <input
                        type="checkbox"
                        class="projectFieldCheckbox"
                        name="fields[]"
                        value="${key}">
                </td>

                <td class="align-middle">
                    ${labels[key]}
                </td>

                <td class="align-middle">
                    ${values[key] ?? 'N/A'}
                </td>
            </tr>
        `;
    });

    html += `
        <tr class="table-primary">
            <td colspan="3" class="fw-bold text-center">
                Items of Work (select item(s) to modify)
            </td>
        </tr>

        <tr id="loadingRow">
            <td colspan="3" class="text-center">
                Loading items...
            </td>
        </tr>
    `;

    html += `</tbody></table>`;

    $('#projectDetailsContainer').html(html);

    // load work items
    $.ajax({
        url: `/get-items-detail/${encodeURIComponent(id)}`,
        type: "GET",
        success: function (response) {

            $('#loadingRow').remove();

            let rows = '';

            if (
                response.status === 'success' &&
                response.value &&
                response.value.length > 0
            ) {

                response.value.forEach((item, index) => {

                    rows += `
                        <tr>
                            <td class="text-center align-middle">
                                <input
                                    type="checkbox"
                                    class="workItemCheckbox"
                                    name="work_item[]"
                                    value="${item.id}">
                            </td>

                            <td class="align-middle">
                                Item ${index + 1}
                            </td>

                            <td>
                                <b>${item.name || 'N/A'}</b><br>
                                Qty: ${item.qty || 'N/A'} |
                                Start Date: ${item.start_date || 'N/A'} |
                                End Date: ${item.end_date || 'N/A'}
                            </td>
                        </tr>
                    `;
                });

            } else {

                rows = `
                    <tr>
                        <td colspan="3" class="text-danger text-center">
                            No items found
                        </td>
                    </tr>
                `;
            }

            $('#projectDetailsContainer table tbody').append(rows);
        },
        error: function () {

            $('#loadingRow').html(`
                <td colspan="3" class="text-danger text-center">
                    Failed to load items
                </td>
            `);
        }
    });
}


$('#requestModificationForm').on('submit', function(e) {
    e.preventDefault();

    let checked =
        $('.projectFieldCheckbox:checked').length +
        $('.workItemCheckbox:checked').length;

    let reason = $('textarea[name="reason"]').val().trim();
    let file = $('#supporting_document')[0].files[0];

    if (checked < 1) {
        showDashboardModal('Please select at least 1 field/item to edit.');
        return;
    }

    if (reason === '') {
        showDashboardModal('Reason is required.');
        return;
    }

    //by dipshikha
    if (!file) {
        showDashboardModal('Modification Order document is required.');
        return;
    }
    //end

    if (file.type !== 'application/pdf') {
        showDashboardModal('Only PDF file allowed.');
        return;
    }

    if (file.size > 2 * 1024 * 1024) {
        showDashboardModal('PDF must be under 2MB.');
        return;
    }

    let formData = new FormData(this);

    $.ajax({
        url: $(this).attr('action'),
        type: 'POST',
        data: formData,
        processData: false,
        contentType: false,
        cache: false,
        success: function(response) {

            if (response.status === 200) {

                $('#requestModificationModal').modal('hide');
                $('#requestModificationForm')[0].reset();
                $('#projectDetailsContainer').empty();

                showSuccessModal(response.message);

            } else {
                showDashboardModal(response.message);
            }
        },
        error: function() {
            showDashboardModal('Something went wrong.');
        }
    });
});

