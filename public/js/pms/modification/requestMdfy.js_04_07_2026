async function loadDataIntoForm(draft, changesData, workItems, itemOfWorks, documents = [], department) {

    const editText = document.getElementById("editModeText");
    editText.innerText = `Project is under edit mode for Project Id: ${draft.project_cd}`;

    const rawFields = changesData?.project_fields || [];
    const editableFields = rawFields.filter(f =>
        f !== "creation_of_new_asset" &&
        f !== "redefine_existing_asset"
    );
    const isNewAsset = rawFields.includes("creation_of_new_asset");
    const isRedefineAsset = rawFields.includes("redefine_existing_asset");

    const dom = {
        projectTypeSelect: document.getElementById("projectTypeSelect"),
        project_name: document.getElementById("project_name"),
        divisionSelect: document.getElementById("division_cd"),
        sub_division_cd: document.getElementById("sub_division_cd"),
        owner_dept_cd: document.getElementById("owner_dept_cd"),
        project_start_date: document.getElementById("project_start_date"),
        project_end_date: document.getElementById("project_end_date"),
        project_awarded_to: document.getElementById("project_awarded_to"),
        est_proj_cost: document.getElementById("est_proj_cost"),
        defect_liability_period: document.getElementById("defect_liability_period"),
        work_order_amount: document.getElementById("work_order_amount"),
        addConstructor: document.getElementById("add-constructor"),
		//by dipshikha
        work_order_no: document.getElementById("work_order_no"),
        work_order_issue_date: document.getElementById("work_order_issue_date"),
        scheme_cd: document.getElementById("scheme_cd"),
        //end												

        // road section
        slnewRdNew: document.getElementById("slnewRdNew"),
        noOfCl: document.getElementById("noOfCl"),
        noOfBr: document.getElementById("noOfBr"),
        noOfRtw: document.getElementById("noOfrtw"),
        noOfPvm: document.getElementById("noOfPvm"),
        rdLength_new: document.getElementById("rdLength"),

        // upgradation
        rdoRoadWithSubAsset: document.getElementById("rdoRoadWithSubAsset"),
        rdoSubAsset: document.getElementById("rdoSubAsset"),
        new_road_name: document.getElementById("new_road_name"),
        road_length: document.getElementById("road_length"),
        new_culverts: document.getElementById("new_culverts"),
        new_bridges: document.getElementById("new_bridges"),
        new_retaining_walls: document.getElementById("new_retaining_walls"),
        new_pavements: document.getElementById("new_pavements"),
    };

    if (dom.projectTypeSelect && draft.project_type_cd) {
        dom.projectTypeSelect.innerHTML = `
            <option value="${draft.project_type_cd}" selected>
                ${draft.proj_type_descr}
            </option>
        `;
        dom.projectTypeSelect.readOnly = true;
        dom.projectTypeSelect.dispatchEvent(new Event("change"));
    }

    if (dom.project_name) dom.project_name.value = draft.project_name || "";
    if (dom.owner_dept_cd) {
        dom.owner_dept_cd.value = draft.owner_dept_cd || "";
        dom.owner_dept_cd.readOnly = true;
    }

    if (draft.division_cd && dom.divisionSelect) {
        dom.divisionSelect.value = draft.division_cd;
        dom.divisionSelect.disabled = true;
    }

    if (draft.sub_division_cd && dom.sub_division_cd) {
        const select = dom.sub_division_cd;
        select.dataset.selected = draft.sub_division_cd;

        loadSubDivisions(draft.division_cd,draft.sub_division_cd);

        const observer = new MutationObserver(() => {

            const saved = dom.sub_division_cd.dataset.selected;

            if (saved && dom.sub_division_cd.value !== saved) {
                dom.sub_division_cd.value = saved;
                 dom.sub_division_cd.dispatchEvent(new Event("change"));
                  observer.disconnect();
                   dom.sub_division_cd.readOnly = true;
            }
        });

        observer.observe(dom.sub_division_cd, {
            childList: true,
            subtree: true
        });
    }


    if (dom.project_start_date)
        dom.project_start_date.value = formatDate(draft.project_start_date);

    if (dom.project_end_date)
        dom.project_end_date.value = formatDate(draft.project_end_date);

    if (dom.project_awarded_to)
        dom.project_awarded_to.value = draft.project_awarded_to || "";

    if (dom.est_proj_cost)
        dom.est_proj_cost.value = draft.est_proj_cost || "";

    if (dom.defect_liability_period)
        dom.defect_liability_period.value = draft.defect_liability_period || "";

    if (dom.work_order_amount)
        dom.work_order_amount.value = draft.work_order_amount || "";

	//by dipshikha
    if (dom.work_order_no)
        dom.work_order_no.value = draft.work_order_no || "";

    if (dom.work_order_issue_date)
        dom.work_order_issue_date.value = formatDate(draft.work_order_issue_date) || "";

    if (draft.scheme_cd && dom.scheme_cd) {
        dom.scheme_cd.value = draft.scheme_cd;
        dom.scheme_cd.dispatchEvent(new Event("change"));
    }
    //end										  


    const fieldMap = {
        project_name: dom.project_name,
        project_end_date: dom.project_end_date,
        project_awarded_to: dom.project_awarded_to,
        est_proj_cost: dom.est_proj_cost,
        defect_liability_period: dom.defect_liability_period,
        work_order_amount: dom.work_order_amount,
    };

    //by dipshikha
    if (String(department) === "14" || String(department) === "3") {
        //end
        const type = String(draft.project_type_cd).trim().toUpperCase();
        if (type === "NEW") {
            Object.assign(fieldMap, {
                new_road_name: dom.slnewRdNew,
                new_road_length: dom.rdLength_new,
                number_of_culvert: dom.noOfCl,
                number_of_bridge: dom.noOfBr,
                number_of_retain_wall: dom.noOfRtw,
            });
        }

        if (type === "UPG") {
            const newAssetFields = [
                dom.new_road_name,
                dom.road_length,
                dom.new_culverts,
                dom.new_bridges,
                dom.new_retaining_walls,
                dom.new_pavements,
                document.getElementById("addRefAssetNewBtn"),
                document.getElementById("closeNewAssetsForm")
            ];

            newAssetFields.forEach(el => {
                if (!el) return;

                if (isNewAsset) {
                    el.readOnly = false;
                } else {
                    el.readOnly = true;
                }
            });

            const addRefAssetNewBtn = document.getElementById("addRefAssetNewBtn");
            const closeNewAssetsForm = document.getElementById("closeNewAssetsForm");

            if (addRefAssetNewBtn) {
                addRefAssetNewBtn.disabled = !isNewAsset;
            }

            if (closeNewAssetsForm) {
                closeNewAssetsForm.disabled = !isNewAsset;
            }

            const redefineFields = [
                dom.rdoRoadWithSubAsset,
                dom.rdoSubAsset,
                document.getElementById("refRoadSelect"),
                document.getElementById("txt_start_chainage"),
                document.getElementById("txt_end_chainage"),
                document.getElementById("refCulvertSelect"),
                document.getElementById("refBridgeSelect"),
                document.getElementById("refWallSelect"),
                document.getElementById("refPVSelect"),
                document.getElementById("addRefAssetBtn")
            ];

            redefineFields.forEach(el => {
                if (!el) return;

                if (isRedefineAsset) {
                    el.readOnly = false;
                } else {
                    el.readOnly = true;
                }
            });

            const addRefAssetBtn = document.getElementById("addRefAssetBtn");
            if (addRefAssetBtn) {
                addRefAssetBtn.disabled = !isRedefineAsset;
            }

            const table = document.getElementById("refAssetTable");

            if (table) {
                table.style.pointerEvents = isRedefineAsset ? "auto" : "none";
                table.style.opacity = isRedefineAsset ? "1" : "0.5";
            }

            if (!isRedefineAsset) {
                dom.rdoRoadWithSubAsset.checked = false;
                dom.rdoSubAsset.checked = false;
            }
        }

        if (type === "MTN") {
            const redefineFields = [
                document.getElementById("maintRoads"),
                document.getElementById("maintCulverts"),
                document.getElementById("maintBridges"),
                document.getElementById("maintWalls"),
                document.getElementById("maintPv"),
                document.getElementById("addMaintAssetBtn")
            ];

            redefineFields.forEach(el => {
                if (!el) return;

                if (isRedefineAsset) {
                    el.readOnly = false;
                } else {
                    el.readOnly = true;
                }
            });
            const table = document.getElementById("mtnAssetTable");

            if (table) {
                table.style.pointerEvents = isRedefineAsset ? "auto" : "none";
                table.style.opacity = isRedefineAsset ? "1" : "0.5";
            }
        }
    }

    Object.values(fieldMap).forEach(field => {
        if (!field) return;

        if (field.tagName === "INPUT" || field.tagName === "TEXTAREA") {
            field.readOnly = true;
        }
    });

    editableFields.forEach(key => {
        const field = fieldMap[key];
        if (!field) return;

        if (field.tagName === "INPUT" || field.tagName === "TEXTAREA") {
            field.readOnly = false;
        }
    });

    if (!editableFields.includes("project_awarded_to")) {
        if (dom.addConstructor) {
            dom.addConstructor.style.pointerEvents = "none";
            dom.addConstructor.style.opacity = "0.5";
            dom.addConstructor.style.cursor = "not-allowed";
            dom.addConstructor.removeAttribute("href");
        }
    } else {
        if (dom.addConstructor) {
            dom.addConstructor.style.pointerEvents = "auto";
            dom.addConstructor.style.opacity = "1";
            dom.addConstructor.style.cursor = "pointer";
            dom.addConstructor.setAttribute("href", "javascript:void(0)");
        }
    }

    const others = draft.others ? JSON.parse(draft.others) : {};

    //by dipshikha
    if (String(department) === "14" || String(department) === "3") {
        //end

        if (String(draft.project_type_cd).trim().toUpperCase() === "NEW") {

            const newRoadName = (others.new_road_name ?? "").toString().trim();

            if (newRoadName !== "") {

                if (dom.slnewRdNew) dom.slnewRdNew.value = newRoadName;

                if (dom.rdLength_new)
                    dom.rdLength_new.value = parseFloat(others.new_road_length) || 0;

                const opt1 = document.getElementById("opt1");
                if (opt1) {
                    opt1.checked = false;
                }
            }

            if (others.new_road_length) {
                if (dom.noOfCl)
                    dom.noOfCl.value = parseInt(others.number_of_culvert) || 0;
                if (dom.noOfBr)
                    dom.noOfBr.value = parseInt(others.number_of_bridge) || 0;
                if (dom.noOfRtw)
                    dom.noOfRtw.value = parseInt(others.number_of_retain_wall) || 0;
            }
        }


        if (String(draft.project_type_cd).trim().toUpperCase() === "UPG") {

            const upg = others.upgradation || {};

            const hasUpgradedRoads = Array.isArray(upg.upgraded_roads) && upg.upgraded_roads.length > 0;

            if (hasUpgradedRoads) {
                if (dom.rdoRoadWithSubAsset) {
                    dom.rdoRoadWithSubAsset.checked = true;
                }
            } else {
                if (dom.rdoSubAsset) {
                    dom.rdoSubAsset.checked = true;
                }
            }

            const tbody = document.querySelector("#refAssetTable tbody");

            if (!tbody) return;

            tbody.innerHTML = "";

            const rows = upg.upgraded_asset_dtls || [];

            rowIndex = 0;

            rows.forEach((item) => {
                rowIndex++;

                const tr = document.createElement("tr");

                tr.innerHTML = `
                    <td>
                        ${item.parent_asset_id ?? ""}
                        <input type="hidden" name="roads[]" value="${item.parent_asset_id}">
                    </td>

                    <td>
                        ${(item.culverts || []).map(c => `
                            <input type="hidden" name="culverts_${rowIndex}[]" value="${c}">
                            <span class="badge bg-info me-1">${c}</span>
                        `).join("")}
                    </td>

                    <td>
                        ${(item.bridges || []).map(b => `
                            <input type="hidden" name="bridges_${rowIndex}[]" value="${b}">
                            <span class="badge bg-warning text-dark me-1">${b}</span>
