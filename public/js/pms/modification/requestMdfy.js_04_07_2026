                    documentUrl
                        ? `
                            <a href="${documentUrl}"
                            target="_blank"
                            class="btn btn-sm btn-outline-danger">
                                <i class="fas fa-file-pdf"></i>
                                View PDF
                            </a>
                        `
                        : `
                            <span class="text-danger">
                                No document uploaded
                            </span>
                        `
                }
            </div>
        `;
    }

    if (workItems.length) {
        html += `
            <div class="border rounded p-3 shadow-sm mt-3">
                <h6 class="fw-bold text-primary mb-3">
                    Work Items Details
                </h6>

                <table class="table table-sm table-bordered">
                    <thead class="table-light">
                        <tr>
                            <th>Item Name</th>
                            <th>Qty</th>
                            <th>Start Date</th>
                            <th>End Date</th>
                        </tr>
                    </thead>
                    <tbody>
        `;

        workItems.forEach(item => {
            const badge = selectedItems.includes(item.id)
                ? `<span class="badge bg-warning text-dark ms-2"
                        style="font-size:11px;">
                        Requested for Edit
                </span>`
                : "";

            html += `
                <tr>
                    <td>
                        ${item.item_name || "N/A"}
                        ${badge}
                    </td>
                    <td>${item.quantity || 0}</td>
                    <td>${item.est_start_date || 0}</td>
                    <td>${item.est_end_date || 0}</td>
                </tr>
            `;
        });

        html += `
                    </tbody>
                </table>
            </div>
        `;
    }

    html += `</div>`;

    $("#projectModalBody").html(html);
});

