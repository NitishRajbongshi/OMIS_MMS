const addSubItemBtn = document.getElementById("addSubItemBtn");

if (addSubItemBtn) {
    addSubItemBtn.addEventListener("click", () => {
        if (!currentRow) return;

        const checked = document.querySelectorAll(".dynamicSubItemCB:checked");
        if (checked.length === 0) {
            alert("Select at least one sub item.");
            return;
        }

        const parentKey = modalItemType.dataset.key;
        const typeName = modalItemType.value;

        // TEMP STORAGE so we don't overwrite data unless valid
        let tempSubItems = {};

        for (let index = 0; index < checked.length; index++) {
            const cb = checked[index];
            const code = cb.value;
            const name = cb.dataset.name;

            const qty =
                document.querySelector(
                    `input[name="temp_subitems[${code}][qty]"]`,
                )?.value || "";
            const start =
                document.querySelector(
                    `input[name="temp_subitems[${code}][start]"]`,
                )?.value || "";
            const end =
                document.querySelector(
                    `input[name="temp_subitems[${code}][end]"]`,
                )?.value || "";

            // Date Validation
            if (start && end) {
                const startDate = new Date(start);
                const endDate = new Date(end);

                if (startDate > endDate) {
                    alert(
                        `End Date should be later than Start Date for ${name}.`,
                    );
                    return;
                }
            }

            // Store in temporary object
            tempSubItems[`sub_item_${index + 1}`] = {
                type: typeName,
                code,
                name,
                quantity: qty,
                start,
                end,
            };
        }

        // After full validation, NOW copy to main data
        subItemsData[parentKey] = tempSubItems;

        // Update hidden input
        document.getElementById("subItems").value =
            JSON.stringify(subItemsData);

        // Update table cell only after success
        const subItemCell = currentRow.querySelector("td:nth-child(6)");
        subItemCell.innerHTML = `
            <button type="button" class="text-primary border-0 bg-transparent outline-0 viewSubBtn">
                <i class="fas fa-eye"></i>
            </button>
            <button type="button" class="btn btn-outline-primary btn-sm editItemBtn">+ Edit item</button>
        `;

        // Close modal ONLY after successful validation
        hideModal(addModal);
    });
}

function openEditModal(parentKey) {
    const editOptions = document.getElementById("editSubItemOptions");
    const container = document.getElementById("editsubItemDetailsContainer");

    container.innerHTML = "";

    const saved = subItemsData[parentKey] || {};

    // Mark selected options
    editOptions.querySelectorAll("input[type='checkbox']").forEach((cb) => {
        const name = cb.nextElementSibling.textContent.trim();
        cb.checked = Object.values(saved).some((s) => s.name === name);
    });

    // Generate dynamic rows for selected subitems
    Object.values(saved).forEach((s) => {
        container.innerHTML += generateEditRow(
            s.code,
            s.name,
            s.quantity,
            s.start,
            s.end,
        );
    });

    // When clicking/unticking checkboxes → regenerate dynamic rows
    editOptions.querySelectorAll("input[type='checkbox']").forEach((cb) => {
        cb.addEventListener("change", () => rebuildEditRows(parentKey));
    });
}

function rebuildEditRows(parentKey) {
    const container = document.getElementById("editsubItemDetailsContainer");
    container.innerHTML = "";

    const saved = subItemsData[parentKey] || {};

    // For all checked subitems in edit dropdown
    document
        .querySelectorAll("#editSubItemOptions input[type='checkbox']:checked")
        .forEach((cb) => {
            const code = cb.value;
            const name = cb.nextElementSibling.textContent.trim();

            const existing = Object.values(saved).find((s) => s.code == code);

            container.innerHTML += generateEditRow(
                code,
                name,
                existing ? existing.quantity : "",
                existing ? existing.start : "",
                existing ? existing.end : "",
            );
        });
}

function generateEditRow(code, name, qty, start, end) {
    return `
        <div class="border rounded p-2 mb-2">
            <p class="fw-bold mb-1">${name}</p>

            <div class="row g-2">
                <div class="col-md-3">
                    <label>Quantity</label>
                    <input type="number"
                           class="form-control form-control-sm editQty"
                           data-code="${code}"
                           value="${qty}">
                </div>

                <div class="col-md-4">
                    <label>Start Date</label>
                    <input type="date"
                           class="form-control form-control-sm editStart"
                           data-code="${code}"
                           value="${start}">
                </div>

                <div class="col-md-4">
                    <label>End Date</label>
                    <input type="date"
                           class="form-control form-control-sm editEnd"
                           data-code="${code}"
                           value="${end}">
                </div>
            </div>
        </div>
    `;
}

