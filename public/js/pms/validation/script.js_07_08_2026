function generateDynamicSubItemRows() {
    const container = document.getElementById("subItemDetailsContainer");
    container.innerHTML = "";

    const checked = document.querySelectorAll(".dynamicSubItemCB:checked");

    if (checked.length === 0) {
        document.getElementById("subItemDropdown").textContent =
            "Select Sub Items";
        return;
    }

    const names = [];
    checked.forEach((cb) => names.push(cb.dataset.name));
    document.getElementById("subItemDropdown").textContent = names.join(", ");

    checked.forEach((cb) => {
        const code = cb.value;
        const name = cb.dataset.name;

        container.innerHTML += `
            <div class="border rounded p-2 mb-2">
                <p class="fw-bold mb-1">${name}</p>

                <div class="row">
                    <div class="col-md-4">
                        <label>Quantity</label>
                        <input type="number"
                               name="temp_subitems[${code}][qty]"
                               placeholder="Quantity"
                               class="form-control form-control-sm dynamicQty">
                    </div>

                    <div class="col-md-4">
                        <label>Start Date</label>
                        <input type="date"
                               name="temp_subitems[${code}][start]"
                               class="form-control form-control-sm dynamicStart">
                    </div>

                    <div class="col-md-4">
                        <label>End Date</label>
                        <input type="date"
                               name="temp_subitems[${code}][end]"
                               class="form-control form-control-sm dynamicEnd">
                    </div>
                </div>
            </div>
        `;
    });
}

