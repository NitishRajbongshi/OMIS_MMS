const workItemsTableBody = document.querySelector("#workItemsTable tbody");

if (workItemsTableBody) {
    workItemsTableBody.addEventListener("click", (e) => {
        // ==============================
        // OPEN ADD SUB ITEM MODAL
        // ==============================
        if (e.target.classList.contains("subItemBtn")) {
            currentRow = e.target.closest("tr");

            const tdFirst = currentRow.querySelector("td:first-child");
            const itemName = tdFirst.innerText.trim();
            const itemValue = tdFirst.querySelector("input").value;

            modalItemType.value = itemName;
            modalItemType.dataset.key = itemValue;

            // Reset UI
            document.querySelector("#subItemsOptions").innerHTML = "";
            document.querySelector("#subItemDetailsContainer").innerHTML = "";
            document.getElementById("subItemSearch").value = "";
            document.getElementById("subItemDropdown").textContent =
                "Select Sub Items";

            // Filter only relevant sub items
            const filtered = allSubItems.filter(
                (si) => si.item_cd == itemValue,
            );

            // Populate checkbox list
            document.getElementById("subItemsOptions").innerHTML = filtered
                .map(
                    (si) => `
                <label>
                    <input type="checkbox"
                           value="${si.sub_item_cd}"
                           data-name="${si.sub_item_name}"
                           class="dynamicSubItemCB">
                    <span class="ms-2">${si.sub_item_name}</span>
                </label>
            `,
                )
                .join("");

            // Re-bind checkbox event for dynamic fields
            document.querySelectorAll(".dynamicSubItemCB").forEach((cb) => {
                cb.addEventListener("change", generateDynamicSubItemRows);
            });

            showModal(addModal);
        }

        // ==============================
        // OPEN VIEW MODAL
        // ==============================
        if (e.target.closest(".viewSubBtn")) {
            const row = e.target.closest("tr");
            const itemValue = row.querySelector("td:first-child input").value;
            const itemName = row
                .querySelector("td:first-child")
                .innerText.trim();

            const subs = subItemsData[itemValue] || {};
            const subsArray = Object.values(subs);

            viewSubItemsTableBody.innerHTML = subsArray
                .map(
                    (s, i) => `
                <tr>
                    <td>${i + 1}</td>
                    <td>${s.name}</td>
                    <td>${s.quantity}</td>
                    <td>${s.start}</td>
                    <td>${s.end}</td>
                </tr>
            `,
                )
                .join("");

            document.querySelector(
                "#viewSubItemsModal .text-primary",
            ).innerHTML =
                `<i class="fa fa-bars"></i> Sub Items for: ${itemName}`;

            showModal(viewModal);
        }

        // ==============================
        // OPEN EDIT MODAL
        // (You can tell me if you want edit modal also converted to dynamic)
        // ==============================
        if (e.target.classList.contains("editItemBtn")) {
            currentRow = e.target.closest("tr");
            const td = currentRow.querySelector("td:first-child");

            const itemName = td.innerText.trim();
            const itemValue = td.querySelector("input").value;

            const dataObj = subItemsData[itemValue] || {};
            const data = Object.values(dataObj);

            document.getElementById("editModalItemType").value = itemName;
            document.getElementById("editModalItemType").dataset.key =
                itemValue;

            const filtered = allSubItems.filter(
                (si) => si.item_cd == itemValue,
            );

            const container = document.getElementById("editSubItemOptions");
            container.innerHTML = filtered
                .map(
                    (si) => `
                <label>
                    <input type="checkbox" value="${si.sub_item_cd}">
                    <span class="ms-2">${si.sub_item_name}</span>
                </label>
            `,
                )
                .join("");

            const selectedNames = data.map((d) => d.name);

            container.querySelectorAll("input").forEach((cb) => {
                const label = cb.nextElementSibling.textContent.trim();
                cb.checked = selectedNames.includes(label);
            });

            openEditModal(itemValue);

            showModal(editModal);
        }
    });
}

