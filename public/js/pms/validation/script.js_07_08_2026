document.addEventListener("DOMContentLoaded", () => {
    // ============================================================
    // 1. PROJECT NAME VALIDATION
    // ============================================================
    const projectNameInput = document.getElementById("project_name");
    const errorDisplay = document.getElementById("projectNameError");

    if (projectNameInput) {
        projectNameInput.addEventListener("input", function () {
            const projectName = this.value.trim();
            if (!projectName) return;

            fetch(`/project-management/check-project-name?name=${encodeURIComponent(projectName)}`)
                .then((res) => res.json())
                .then((data) => {
                    if (data.exists) {
                        this.setCustomValidity("Project Name already exists");
                        if (errorDisplay)
                            errorDisplay.textContent =
                                "Project name already exists.";
                        this.style.borderColor = "red";
                    } else {
                        this.setCustomValidity("");
                        if (errorDisplay) errorDisplay.textContent = "";
                        this.style.borderColor = "";
                    }
                })
                .catch((err) =>
                    console.error("Error checking project name:", err),
                );
        });
    }

    // ============================================================
    // 2. OFFICE SELECT AUTOFILL
    // ============================================================
    const officeSelect = document.getElementById("site_incharge_office_cd");
    const nameInput = document.getElementById("site_incharge_name");
    const phoneInput = document.getElementById("site_incharge_ph_no");

    if (officeSelect) {
        officeSelect.addEventListener("change", function () {
            const selected = this.options[this.selectedIndex];
            if (nameInput)
                nameInput.value = selected.getAttribute("data-name") || "";
            if (phoneInput)
                phoneInput.value = selected.getAttribute("data-phone") || "";
        });
    }

    // ============================================================
    // 3. NEGATIVE VALUE PREVENTION
    // ============================================================
    ["noOfCl", "noOfBr", "noOfrtw", "noOfPvm"].forEach((id) => {
        const input = document.getElementById(id);
        if (input) {
            input.addEventListener("input", function () {
                if (parseFloat(this.value) < 0) {
                    this.value = "";
                    alert("Value can't be negative");
                }
            });
        }
    });

    // ============================================================
    // 4. DATE VALIDATION
    // ============================================================
    const startDateInputs = document.getElementById("project_start_date");
    const endDateInputs = document.getElementById("project_end_date");

    if (endDateInputs && startDateInputs) {
        endDateInputs.addEventListener("blur", function () {
            if (this.value && startDateInputs.value) {
                const start = new Date(startDateInputs.value);
                const end = new Date(this.value);

                this.setCustomValidity("");

                if (end < start) {
                    this.setCustomValidity(
                        "Stipulated End date must be later than project start date.",
                    );
                    this.reportValidity();
                }
            } else {
                this.setCustomValidity("");
            }
        });
    }

    // ============================================================
    // 5. DOCUMENT & IMAGE VALIDATION (Helper Function)
    // ============================================================
    function validateFile(inputId, allowedExts, maxSizeMB = 2) {
        const input = document.getElementById(inputId);
        if (!input) return;

        input.addEventListener("change", function () {
            const file = this.files[0];
            if (!file) return;

            const ext = file.name.split(".").pop().toLowerCase();
            const maxSize = maxSizeMB * 1024 * 1024;

            if (!allowedExts.includes(ext)) {
                alert(`Invalid file type. Allowed: ${allowedExts.join(", ")}`);
                this.value = "";
                return;
            }

            if (file.size > maxSize) {
                alert(`File size exceeds ${maxSizeMB} MB limit.`);
                this.value = "";
                return;
            }

            if (typeof showRemoveBtn === "function") showRemoveBtn(inputId);
        });
    }
    validateFile("panCardDoc", ["pdf"]);
	validateFile("passbookDoc", ["pdf"]);
    validateFile("workOrder", ["pdf"]);
    validateFile("projectPlan", ["pdf"]);
    validateFile("drpDocument", ["pdf", "xls", "xlsx"]);
    validateFile("designDoc", ["pdf"]);

    let selectedFiles = [];

    document.getElementById("images")?.addEventListener("change", function () {
        let files = Array.from(this.files);

        let allowedTypes = ["image/jpeg", "image/jpg"];
        let maxSize = 1024 * 1024; //1MB

        files.forEach((file) => {
            if (!allowedTypes.includes(file.type)) {
                alert("Only JPG/JPEG files are allowed.");
                return;
            }

            if (file.size > maxSize) {
                alert("File size must be less than 1MB.");
                return;
            }

            selectedFiles.push(file);
        });

        updatePreview();
    });

    function updatePreview() {
        let previewContainer = document.getElementById("imagesPreview");
        previewContainer.innerHTML = "";

        selectedFiles.forEach((file, index) => {
            let reader = new FileReader();

            reader.onload = function (e) {
                let col = document.createElement("div");
                col.classList.add(
                    "col-3",
                    "col-md-2",
                    "mb-2",
                    "position-relative",
                );

                let img = document.createElement("img");
                img.src = e.target.result;
                img.style.width = "100%";
                img.style.height = "auto";
                img.classList.add("border");

                let removeBtn = document.createElement("button");
                removeBtn.innerHTML = "×";
                removeBtn.classList.add("btn", "btn-danger", "btn-sm");
                removeBtn.style.position = "absolute";
                removeBtn.style.top = "5px";
                removeBtn.style.right = "1px";

                removeBtn.onclick = function () {
                    removeImage(index);
                };

                col.appendChild(img);
                col.appendChild(removeBtn);
                previewContainer.appendChild(col);
            };

            reader.readAsDataURL(file);
        });

        rebuildFileInput();
    }

    function removeImage(index) {
        selectedFiles.splice(index, 1);
        updatePreview();
    }

    function rebuildFileInput() {
        let dataTransfer = new DataTransfer();

        selectedFiles.forEach((file) => {
            dataTransfer.items.add(file);
        });

        document.getElementById("images").files = dataTransfer.files;
    }
});
