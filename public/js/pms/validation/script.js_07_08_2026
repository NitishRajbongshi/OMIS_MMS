// 6. DROPDOWN LOGIC (Reusable Helper)
// ============================================================
function setupCustomDropdown(
    btnId,
    menuId,
    searchId,
    optionsContainerId,
    hiddenInputId,
) {
    const btn = document.getElementById(btnId);
    const menu = document.getElementById(menuId);
    const search = document.getElementById(searchId);
    const container = document.getElementById(optionsContainerId);
    const hiddenInput = hiddenInputId
        ? document.getElementById(hiddenInputId)
        : null;

    if (!btn || !menu) return;

    // Toggle
    btn.addEventListener("click", (e) => {
        e.stopPropagation();
        // Use classList for consistency (better than style.display toggling manually)
        // Assuming CSS class .show { display: block; } exists or logic matches your code
        // Your code mixed style.display and classList.toggle. Standardizing to classList or style logic.
        // Keeping logic strictly as per your request (Predecessor uses style, SubItems use classList).
        if (
            menu.classList.contains("dropdown-menu-custom") ||
            menuId === "predecessorMenu"
        ) {
            menu.style.display =
                menu.style.display === "block" ? "none" : "block";
        } else {
            menu.classList.toggle("show");
        }
    });

    // Close on outside click
    document.addEventListener("click", (e) => {
        if (!menu.contains(e.target) && e.target !== btn) {
            if (menuId === "predecessorMenu") menu.style.display = "none";
            else menu.classList.remove("show");
        }
    });

    // Search
    if (search && container) {
        search.addEventListener("input", () => {
            const term = search.value.toLowerCase();
            // Check if labels (predecessor) or divs (subitems) wrapper exists
            // Your code: predecessor uses labels directly, subitems use checkbox parent
            const items = container.querySelectorAll(
                menuId === "predecessorMenu"
                    ? "label"
                    : "input[type='checkbox']",
            );

            items.forEach((item) => {
                const el =
                    menuId === "predecessorMenu" ? item : item.parentElement;
                const text = el.textContent.toLowerCase();
                el.style.display = text.includes(term)
                    ? menuId === "predecessorMenu"
                        ? "block"
                        : "flex"
                    : "none";
            });
        });
    }

    // Checkbox Logic
    if (container) {
        container.addEventListener("change", (e) => {
            if (e.target.type === "checkbox") {
                const checkboxes = container.querySelectorAll(
                    "input[type='checkbox']",
                );
                const selected = Array.from(checkboxes)
                    .filter((c) => c.checked)
                    .map((c) => c.nextElementSibling.textContent.trim());

                const defaultText =
                    btnId === "predecessorDropdown"
                        ? "Select Predecessor"
                        : btnId === "subItemDropdown"
                          ? "Select Sub Items"
                          : "Select Sub Items";

                btn.textContent = selected.length
                    ? selected.join(", ")
                    : defaultText;

                if (hiddenInput) hiddenInput.value = selected.join(",");
            }
        });
    }
}

