<script>
    $(document).ready(function () {

        // Start DataTable
        $('#inspectionTable').DataTable({
            pageLength: 10,
            autoWidth: false,
            columnDefs: [
                { orderable: false, targets: 3 }
            ]
        });

        // Expand / collapse the sub table inside the same cell
        // (attached to the table so it keeps working after paging and searching)
        $('#inspectionTable tbody').on('click', '.toggle-btn', function () {
            $(this).toggleClass('open');
            $(this).siblings('.sub-content').slideToggle(200);
        });

    });
</script>
